# Copy this file to backend/.env and fill it in. NEVER commit .env.

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
PAYGUARD_SECRET_KEY=

# PostgreSQL (use a simple alphanumeric password, or URL-encode special characters)
DATABASE_URL=postgresql+psycopg://payguard:YOUR_PASSWORD@localhost:5432/payguard

ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_REGISTRATION=true
